# ==============================================================================
# InsureChain VoiceGuard — Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and provide your actual environment values.
# NEVER commit real credentials to source control.

# Application Settings
APP_NAME=InsureChain VoiceGuard Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
APP_URL=http://localhost:5173

# Database Configuration (Neon Cloud PostgreSQL strictly required)
# Both DATABASE_URL and DB_URI are supported. Must use postgresql:// or postgres://
DATABASE_URL=postgresql://<neon_user>:<neon_password>@<neon_host>/<neon_dbname>?sslmode=require
DATABASE_CONNECT_TIMEOUT=10

# Security & JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_32_byte_secret_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1
CUSTOMER_ACTIVATION_EXPIRE_HOURS=48

# Operator Authority Bootstrap Secret
# Used exclusively for the initial system operator setup of the primary authority account
AUTHORITY_BOOTSTRAP_SECRET=change_to_a_secure_operator_bootstrap_secret

# Transactional Email Service
# Options: 'console' (local terminal logging), 'test' (in-memory test recording), 'smtp' (live mail delivery)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@insurechain-voiceguard.local
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# Cloudinary Integration (Private storage for audio recordings & documents)
# Validated when Cloudinary client is initialized.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ElevenLabs Voice AI (Speech-to-Text transcription & spoken explanation TTS)
# Validated when ElevenLabs client is initialized.
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Google Gemini AI (Promise extraction vs policy clause comparison)
# Validated when Gemini client is initialized.
GEMINI_API_KEY=your_gemini_api_key
